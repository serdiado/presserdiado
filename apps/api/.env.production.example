# =============================================================================
# Presserdiado API — Production (.env.production.example)
#
# Production'a deploy ederken bu dosyayi `.env.production` olarak kopyalayin
# ve gercek degerlerle doldurun. .env.production gitignore'da, asla commit'lemeyin.
# docker-compose.prod.yml bu dosyayi --env-file ile okur.
#
# Domain plani (Oracle VPS, CyberPanel reverse-proxy, tezgahimdan.com'dan izole):
#   Web        : https://serdiado.com.tr        (container: 127.0.0.1:3010)
#   API        : https://api.serdiado.com.tr    (container: 127.0.0.1:3011)
#   Uploads    : https://api.serdiado.com.tr/uploads/...
#   Print-view : https://serdiado.com.tr/print-view (Puppeteer buraya gider)
# =============================================================================

# --- docker-compose.prod.yml servisleri icin ---
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_PASSWORD
MYSQL_USER=presserdiado
MYSQL_PASSWORD=GENERATE_STRONG_PASSWORD
MYSQL_DATABASE=presserdiado

MINIO_ROOT_USER=presserdiado
MINIO_ROOT_PASSWORD=GENERATE_STRONG_PASSWORD

# api container'inin GORECEGI DATABASE_URL — yukaridaki MYSQL_* degerleriyle otomatik
# uyumlu olmasi icin docker-compose.prod.yml bunu KENDISI kurar, burada AYRICA yazmayin.

# JWT — `openssl rand -hex 64` ile uretilmis uzun rastgele degerler kullanin
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_openssl_rand_hex_64

# S3/MinIO bucket adlari (self-hosted MinIO container - docker-compose.prod.yml)
S3_BUCKET=matbaapro
S3_ORDERS_BUCKET=presserdiado-orders
S3_REGION=us-east-1

# CORS — sadece resmi domain(ler)
CORS_ORIGIN=https://serdiado.com.tr

# Web app URL — Puppeteer export icin (HTTPS olmali, public erisilebilir)
WEB_BASE_URL=https://serdiado.com.tr

# Pilot: genel kayit KAPALI — 5 bilinen market hesabi reset-password.ts ile acilir.
# Herkese acik resmi launch'ta true yapin.
REGISTRATION_ENABLED=false

# --- apps/web Docker build-arg'i (docker compose build --build-arg ile ayni dosyadan okunur) ---
# Tarayicidan erisilecek GERCEK public API adresi (Docker-ici servis adi DEGIL).
VITE_API_URL=https://api.serdiado.com.tr/api/v1
